          <mxGeometry x="610" y="205" width="220" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="discard" value="Bỏ xung" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;fontColor=#7f1d1d;fontSize=21;fontStyle=1;" vertex="1" parent="1">
