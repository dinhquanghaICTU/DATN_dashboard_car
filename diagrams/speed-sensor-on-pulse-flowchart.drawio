  <diagram id="speed-on-pulse" name="SpeedSensor onPulse Flowchart">
    <mxGraphModel dx="1900" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3300" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
