        <mxCell id="wait" value="Chờ lần sau" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#64748b;strokeWidth=2;fontColor=#334155;fontSize=21;fontStyle=1;" vertex="1" parent="1">
