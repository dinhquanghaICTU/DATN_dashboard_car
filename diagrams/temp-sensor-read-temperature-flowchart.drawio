        <mxCell id="emit" value="Phát dataUpdated&lt;br&gt;(nhiệt độ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=2;fontColor=#4c1d95;fontSize=21;fontStyle=1;" vertex="1" parent="1">
