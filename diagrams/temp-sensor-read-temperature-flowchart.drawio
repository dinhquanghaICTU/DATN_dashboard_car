        <mxCell id="var2" value="Tính hệ số bù&lt;br&gt;var2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontColor=#14532d;fontSize=21;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1580" y="220" width="230" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="tfine" value="Tính giá trị hiệu chỉnh&lt;br&gt;tFine = var1 + var2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontColor=#14532d;fontSize=21;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1880" y="215" width="300" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="temperature" value="Chuyển đổi nhiệt độ&lt;br&gt;T = ((tFine × 5 + 128) &amp;gt;&amp;gt; 8) / 100" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;strokeWidth=2;fontColor=#7c2d12;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="2250" y="210" width="390" height="120" as="geometry"/>
