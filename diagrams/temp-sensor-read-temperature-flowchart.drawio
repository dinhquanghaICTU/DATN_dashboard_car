        <mxCell id="finish" value="Kết thúc" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;fontColor=#1e3a8a;fontSize=21;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="3040" y="225" width="190" height="90" as="geometry"/>
