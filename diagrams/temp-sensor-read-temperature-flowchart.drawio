        <mxCell id="note" value="digT1, digT2, digT3 là các hệ số hiệu chuẩn được đọc từ BMP280." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;strokeWidth=2;fontColor=#713f12;fontSize=19;" vertex="1" parent="1">
