          <mxGeometry x="980" y="30" width="1100" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="start" value="Bắt đầu đọc&lt;br&gt;nhiệt độ" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;fontColor=#1e3a8a;fontSize=21;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="220" width="190" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="read" value="Đọc 3 byte dữ liệu&lt;br&gt;qua I²C" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontColor=#0c4a6e;fontSize=21;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="220" width="250" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="check" value="Đủ 3 byte?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;fontColor=#78350f;fontSize=21;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="205" width="220" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="error" value="Báo lỗi I²C&lt;br&gt;và kết thúc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;fontColor=#7f1d1d;fontSize=21;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="630" y="430" width="200" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="adc" value="Ghép dữ liệu thành&lt;br&gt;ADC nhiệt độ 20-bit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=2;fontColor=#1f2937;fontSize=21;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="910" y="215" width="300" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="var1" value="Tính hệ số bù&lt;br&gt;var1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontColor=#14532d;fontSize=21;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1280" y="220" width="230" height="100" as="geometry"/>
