[Unit]
Description=DATN Dashboard Car
After=bluetooth.service pigpiod.service
Wants=bluetooth.service pigpiod.service
ConditionPathExists=/usr/local/bin/appDATN_dashboard_car

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi
Environment=LD_LIBRARY_PATH=/usr/local/qt6/lib
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=QT_QPA_PLATFORM=eglfs
Environment=QT_QPA_EGLFS_ALWAYS_SET_MODE=1
ExecStart=/usr/local/bin/appDATN_dashboard_car
Restart=on-failure
RestartSec=3
KillMode=control-group
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
